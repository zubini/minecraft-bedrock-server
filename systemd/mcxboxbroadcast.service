[Unit]
Description=MCXboxBroadcast (Xbox Live friends session for Bedrock)
Documentation=https://github.com/MCXboxBroadcast/Broadcaster
After=network-online.target minecraft-bedrock.service
Wants=network-online.target
# Prefer starting after local Bedrock so joins hit a ready TCP/UDP listener.
# Soft dependency only: remote-address can still point at any reachable BDS.

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/mcxboxbroadcast
ExecStart=/usr/bin/java -Xms64M -Xmx256M -jar /opt/mcxboxbroadcast/MCXboxBroadcastStandalone.jar
Restart=on-failure
RestartSec=15
Nice=10

# Auth tokens and config live under WorkingDirectory
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
