# Minecraft Bedrock Server configuration
# Copied to /etc/minecraft-bedrock/config.env (only if it does not exist yet).

# System timezone (applied during provisioning; update timer uses local time)
TIMEZONE=Europe/Zurich

# Install directory (server binary and world)
INSTALL_DIR=/opt/minecraft-bedrock

# Directory for world backups
BACKUP_DIR=/opt/minecraft-bedrock/backups

# Number of world backups to keep (older ones are deleted)
BACKUP_KEEP=3

# systemd service user
SERVICE_USER=minecraft

# systemd service name
SERVICE_NAME=minecraft-bedrock

# Official download-links API (release, not preview)
DOWNLOAD_LINKS_API=https://net-secondary.web.minecraft-services.net/api/v1.0/download/links
DOWNLOAD_TYPE=serverBedrockLinux

# Log file for the update script
UPDATE_LOG=/var/log/minecraft-bedrock/update.log
