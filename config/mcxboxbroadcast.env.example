# MCXboxBroadcast configuration
# Copied to /etc/mcxboxbroadcast/config.env (only if it does not exist yet).

# Public IP or hostname that Switch/clients use to reach the Bedrock server.
# Required on first install (when config.yml does not exist yet).
# Example: BROADCAST_IP=203.0.113.10
BROADCAST_IP=

# Bedrock UDP port (default 19132)
BROADCAST_PORT=19132

# Install directory (JAR + config.yml + auth cache)
INSTALL_DIR=/opt/mcxboxbroadcast

# systemd service user (reuse minecraft from Bedrock provision if present)
SERVICE_USER=minecraft

# systemd service name
SERVICE_NAME=mcxboxbroadcast

# Fallback MOTD / world name if server query fails
HOST_NAME="Minecraft Server"
WORLD_NAME=Bedrock
MAX_PLAYERS=10
