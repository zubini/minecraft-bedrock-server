# MCXboxBroadcast Standalone – points console friends at your Bedrock server.
# Generated by setup-mcxboxbroadcast.sh (do not commit server-specific copies).
#
# Do not change!
config-version: 8

# Core session settings
session:
  # Public IP or hostname clients can reach (not 127.0.0.1 / LAN-only)
  remote-address: "__BROADCAST_IP__"

  # Bedrock UDP port
  remote-port: __BROADCAST_PORT__

  # Session update interval in seconds (minimum 20 – Xbox rate limits)
  update-interval: 30

  # Query the Bedrock server for MOTD / player count
  query-server: true

  # Use checker.geysermc.org if the native ping fails
  web-query-fallback: false

  # Fall back to session-info below if all query methods fail
  config-fallback: true

  session-info:
    host-name: "__HOST_NAME__"
    world-name: "__WORLD_NAME__"
    players: 0
    max-players: __MAX_PLAYERS__

# Friend / follower list sync
friend-sync:
  update-interval: 60

  # Accept friend requests automatically
  auto-friend: true

  # Send an invite when a friend is added
  initial-invite: true

  expiry:
    enabled: false
    days: 15
    check: 1800

notifications:
  enabled: false
  webhook-url: ""
  session-expired-message: |
    Xbox Session expired, sign in again to update it.

    Use the following link to sign in: %s
    Enter the code: %s
  friend-restriction-message: |
    %s (%s) has restrictions in place that prevent them from being friends with our account.
